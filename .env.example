GEMINI_API_KEY=

# GOOGLE_SERVICE_ACCOUNT_JSON: Path to your Google Service Account credentials file.
# To generate this file:
#   1. Go to https://console.cloud.google.com/
#   2. Create or select a project
#   3. Enable the Google Sheets API for that project
#   4. Go to IAM & Admin → Service Accounts
#   5. Create a new service account
#   6. Click on it → Keys tab → Add Key → Create new key → JSON
#   7. Download the JSON file and place it in the project root directory
#
# Then share your Google Sheet with the service account email
# (e.g. something@your-project.iam.gserviceaccount.com) with Editor access.
#
# WARNING: Never commit service_account.json to version control.
# Make sure it is listed in your .gitignore.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

GOOGLE_SHEET_ID=
